{
  "name": "wallmaker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint": "oxlint",
    "build": "tsc -b && vite build",
    "build:cep": "vite build --mode cep",
    "build:app": "vite build --mode app && node scripts/build-app-render.mjs",
    "app": "npm run build:app && electron app/main.mjs",
    "app:package": "npm run build:app && node scripts/package-app.mjs",
    "cep:install": "npm run build:cep && node scripts/install-cep.mjs",
    "cep:link": "npm run build:cep && node scripts/install-cep.mjs --link",
    "cep:uninstall": "node scripts/install-cep.mjs --uninstall",
    "test": "npm run typecheck && npm run lint && npm run test:unit && npm run test:fuzz && npm run test:host && npm run test:rebuild && npm run test:robust",
    "test:unit": "tsx test/unit.ts",
    "test:videos": "node scripts/make-test-videos.mjs",
    "test:host": "node test/run-host.mjs",
    "test:rebuild": "node test/run-rebuild.mjs",
    "test:robust": "node test/run-robust.mjs",
    "test:fuzz": "tsx test/fuzz.ts 12000",
    "test:perf": "tsx test/perf.ts",
    "test:panel": "node test/run-panel.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.4.1",
    "oxlint": "^1.75.0",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "ws": "^8.18.0"
  },
  "description": "Wallmaker — build perfect grids of videos as real After Effects layers, with a keyframable camera that zooms out of one screen to reveal the whole wall.",
  "repository": {
    "type": "git",
    "url": "https://github.com/newomp4/wallmaker.git"
  },
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
